# Copy to  app/.env  on the server:   cp deploy/docker/env.example .env && chmod 600 .env
# No inline comments after values (Docker would keep them as part of the value).

# --- Docker ---------------------------------------------------------------
# The Docker network your existing Caddy container is on (see README: docker inspect remiai-caddy-1).
CADDY_NETWORK=CHANGE_ME
# Limits so the automations cannot starve the other apps on this server. Check RAM first: free -h
AUTOMATION_MEM_LIMIT=6g
AUTOMATION_CPUS=3

# --- First admin (created on first start; remove the password line afterwards) ---
AUTOMATION_ADMIN_EMAIL=you@yourcompany.com
AUTOMATION_ADMIN_PASSWORD=CHANGE_ME_to_something_long

# --- Site ---------------------------------------------------------------
AUTOMATION_COOKIE_SECURE=true
AUTOMATION_TRUST_PROXY=true
AUTOMATION_ALLOWED_ORIGINS=https://automation.metacare.one

# Browser window size (width,height). Keep a desktop size: a small headless window makes Office Ally show its mobile menu and the login times out.
AUTOMATION_WINDOW_SIZE=1920,1080

# --- Capacity: start small on a shared server, raise after watching docker stats ---
AUTOMATION_MAX_CONCURRENT_RUNS=2
AUTOMATION_MAX_TOTAL_WORKERS=4
AUTOMATION_MAX_WORKERS=2
AUTOMATION_MAX_ACTIVE_PER_USER=5
AUTOMATION_RUN_TIMEOUT_HOURS=12

# --- Retries, logs, retention ---
AUTOMATION_AUTO_RETRIES=1
AUTOMATION_RETRY_BACKOFF_SECONDS=60
AUTOMATION_ENGINE_LOG=redacted
AUTOMATION_LOG_MAX_MB=20
AUTOMATION_RETENTION_FILES_DAYS=30
AUTOMATION_RETENTION_ROWS_DAYS=180
AUTOMATION_SESSION_HOURS=12
