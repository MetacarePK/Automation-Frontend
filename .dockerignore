# Keep secrets, data and clutter out of the image.
.git
.gitignore
**/.env
**/.env.*
**/auth_state.json
**/__pycache__
**/.pytest_cache
storage
**/*.xlsx
**/*.db
**/*.db-wal
**/*.db-shm
backend/tests
automations/*/tests
docs
deploy/README.md
deploy/Caddyfile
deploy/automation.service
deploy/harden.sh
deploy/docker/README.md
deploy/docker/env.example
deploy/docker/Caddyfile.snippet
*.md
Dockerfile
docker-compose.yml
start.sh
start.bat
