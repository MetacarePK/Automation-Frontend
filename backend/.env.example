# Server settings. Real environment variables override this file. Never commit it.

# First admin: created automatically on first start if no admin exists yet.
# After the first start, delete the password line (the account stays).
AUTOMATION_ADMIN_EMAIL=you@yourcompany.com
AUTOMATION_ADMIN_PASSWORD=

# Set these once the site is on HTTPS at your domain.
AUTOMATION_COOKIE_SECURE=false
AUTOMATION_TRUST_PROXY=false
AUTOMATION_ALLOWED_ORIGINS=

# Browser used by the engines. Windows server: msedge + false (same as your PC).
# Linux server: AUTOMATION_BROWSER_CHANNEL=chromium and AUTOMATION_HEADLESS=true  (verify with: python -m app.cli preflight)
AUTOMATION_BROWSER_CHANNEL=msedge
AUTOMATION_HEADLESS=false

# How much the server may do at once.
# runs at the same time, all automations together
AUTOMATION_MAX_CONCURRENT_RUNS=2
# browser windows at the same time, all runs together
AUTOMATION_MAX_TOTAL_WORKERS=8
# windows in one run
AUTOMATION_MAX_WORKERS=4
# queued + running runs per person
AUTOMATION_MAX_ACTIVE_PER_USER=5
AUTOMATION_RUN_TIMEOUT_HOURS=12

# Retries: only after a crash (never after a login or input error). Backoff doubles each attempt.
AUTOMATION_AUTO_RETRIES=1
AUTOMATION_RETRY_BACKOFF_SECONDS=60

# Logs and retention (0 = keep forever).
# redacted | off (off stores only the dashboard's own lines, no engine output)
AUTOMATION_ENGINE_LOG=redacted
AUTOMATION_LOG_MAX_MB=20
# sheets, results and logs of a finished run
AUTOMATION_RETENTION_FILES_DAYS=30
# per-row details (patient name, date of service, IDs)
AUTOMATION_RETENTION_ROWS_DAYS=180

AUTOMATION_SESSION_HOURS=12
